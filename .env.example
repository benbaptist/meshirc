# MeshCore Node
MESHCORE_HOST=192.168.1.100
MESHCORE_PORT=5000
MESHCORE_NODE_NAME=meshirc-bridge

# IRC Server
IRC_HOST=irc.libera.chat
IRC_PORT=6667
IRC_NICK=MeshBridge
IRC_REALNAME=MeshCore IRC Bridge
IRC_USE_TLS=false

# Channel Configuration
# Use # prefix for public IRC channels, no prefix for private channels
IRC_CHANNEL=#meshnet
# MeshCore channel name (created automatically on the node)
MESHCORE_CHANNEL=irc-bridge
# Type: "public" (hashtag) or "private" (direct group)
MESHCORE_CHANNEL_TYPE=public
# Channel index on the radio (0-39). 0 is usually free.
MESHCORE_CHANNEL_INDEX=0

# Logging
LOG_LEVEL=INFO
